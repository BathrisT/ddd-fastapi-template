# Скопировать в .env и заполнить. Вложение через двойное подчёркивание:
# APP__ENV → Settings.app.env, DATABASE__HOST → Settings.database.host.

# ─── Приложение ──────────────────────────────────────────────────────────────
APP__ENV=development                      # development | production
APP__API_BASE_URL=http://localhost:8000
APP__FRONTEND_BASE_URL=http://localhost:5173
# JSON-массив: APP__CORS_ORIGINS=["http://localhost:5173"]. Пусто — CORS выключен.
APP__CORS_ORIGINS=[]
# Ключ шифрования секретов в базе. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Пусто — шифр работает «насквозь» (значения хранятся как есть). Для прода это
# не вариант: смена пустого ключа на настоящий не расшифрует то, что уже лежит.
APP__FERNET_KEY=
APP__UPLOADS_DIR=uploads
# DSN Sentry. Пусто — Sentry выключен целиком, включая приёмник логов.
APP__SENTRY_DSN=

# ─── База данных ─────────────────────────────────────────────────────────────
DATABASE__HOST=localhost
# 5433 — порт docker-compose.local.yml, чтобы не конфликтовать с локальным PG
DATABASE__PORT=5433
DATABASE__USER=postgres
DATABASE__PASSWORD=secret
DATABASE__NAME=app
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_RECYCLE=1800

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0

# ─── Языковая модель ─────────────────────────────────────────────────────────
LLM__API_KEY=
LLM__MODEL=gpt-4o-mini
# Пусто — официальный OpenAI. Иначе адрес совместимого шлюза.
LLM__BASE_URL=
LLM__TIMEOUT=60
# socks5://user:pass@host:1080 или http://host:3128. Пусто — без прокси.
LLM__PROXY=

# ─── docker-compose ──────────────────────────────────────────────────────────
# Порт, на котором API виден на хосте (внутри контейнера всегда 8000).
API__PORT=8000
